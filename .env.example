# SMTP Configuration (optional — codes print to console if not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@versaterm.com

# Domain restriction for employee emails
ALLOWED_DOMAIN=versaterm.com

# Auth settings
CODE_EXPIRY_MINUTES=10
SESSION_TIMEOUT_HOURS=8
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=15

# Database path
DB_PATH=auth.db

# LLM / OpenAI-compatible API (required for AI modules)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
